                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = option,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextColor3 = theme.text,
                    ZIndex = 11
                }, menu)

                item.MouseButton1Click:Connect(function()
                    selected = option
                    dropdown.Text = selected
                    menu.Visible = false
                    library.Flags[label] = selected
                    if callback then
                        callback(selected)
                    end
                end)
            end

            dropdown.MouseButton1Click:Connect(function()
                menu.Visible = not menu.Visible
            end)

            library.Flags[label] = selected
            registerElement(label, row)
            return row
        end

        table.insert(tab.Sections, section)
        return section
    end

    library.Tabs[name] = tab
    return tab
end

function library:SetTab(tab)
    for _, other in pairs(library.Tabs) do
        local pageObject = page:FindFirstChild(other.Name .. "Page")
        if pageObject then
            pageObject.Visible = false
        end
    end

    for _, child in ipairs(sidebar:GetChildren()) do
        if child:IsA("TextButton") then
            child.BackgroundTransparency = 0
            child.BackgroundColor3 = theme.tabSelected

            local indicator = child:FindFirstChild("Indicator")
            local iconLabel = child:FindFirstChild("Icon")
            local titleLabel = child:FindFirstChild("Title")

            if indicator then
                indicator.Visible = false
            end

            if iconLabel then
                iconLabel.TextColor3 = theme.subtext
            end

            if titleLabel then
                titleLabel.TextColor3 = theme.subtext
            end
        end
    end

    local selectedPage = page:FindFirstChild(tab.Name .. "Page")
    if selectedPage then
        selectedPage.Visible = true
    end

    local selectedButton = sidebar:FindFirstChild(tab.Name .. "Tab")
    if selectedButton then
        selectedButton.BackgroundColor3 = theme.tabSelected
        selectedButton.BackgroundTransparency = 0

        local indicator = selectedButton:FindFirstChild("Indicator")
        local iconLabel = selectedButton:FindFirstChild("Icon")
        local titleLabel = selectedButton:FindFirstChild("Title")

        if indicator then
            indicator.Visible = true
        end

        if iconLabel then
            iconLabel.TextColor3 = theme.text
        end

        if titleLabel then
            titleLabel.TextColor3 = theme.text
        end
    end

    library.CurrentTab = tab
end

