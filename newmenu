local HttpService = game:GetService("HttpService")
local CONFIG_FOLDER = "AsylumUI/Configs"

local function safeConfigName(name)
    name = tostring(name or "default")
    name = string.gsub(name, "[^%w%-%_ ]", "")
    name = string.gsub(name, "%s+", "_")
    if name == "" then
        return "default"
    end
    return name
end

local function ensureConfigFolder()
    if type(makefolder) ~= "function" then
        return false
    end

    local folderExists = type(isfolder) == "function" and isfolder(CONFIG_FOLDER)
    if not folderExists then
        if type(isfolder) ~= "function" or not isfolder("AsylumUI") then
            pcall(makefolder, "AsylumUI")
        end

        local created = pcall(makefolder, CONFIG_FOLDER)
        if not created and type(isfolder) == "function" then
            return isfolder(CONFIG_FOLDER)
        end
    end

    return type(isfolder) ~= "function" or isfolder(CONFIG_FOLDER)
end

local function listSavedConfigs()
    local configs = {}
    if type(listfiles) ~= "function" then
        return configs
    end

    if type(isfolder) == "function" and isfolder(CONFIG_FOLDER) then
        for _, file in ipairs(listfiles(CONFIG_FOLDER)) do
            local normalized = string.gsub(file, "\\", "/")
            local name = normalized:match("^" .. CONFIG_FOLDER .. "/(.+)%.json$")
            if name then
                table.insert(configs, name)
            end
        end
    end

    table.sort(configs)
    return configs
end

function library:SaveConfig(name)
    local configName = safeConfigName(name)
    if not ensureConfigFolder() or type(writefile) ~= "function" then
        return false
    end

    local snapshot = {}
    for key, value in pairs(self.Flags) do
        snapshot[key] = value
    end

    return pcall(function()
        writefile(CONFIG_FOLDER .. "/" .. configName .. ".json", HttpService:JSONEncode(snapshot))
    end)
end

function library:LoadConfig(name)
    local configName = safeConfigName(name)
    local filePath = CONFIG_FOLDER .. "/" .. configName .. ".json"

    if type(isfile) ~= "function" or type(readfile) ~= "function" or not isfile(filePath) then
        return false
    end

    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(filePath))
    end)

    if not success or type(decoded) ~= "table" then
        return false
    end

    for key, value in pairs(decoded) do
        self.Flags[key] = value
        self:ApplyConfigBinding(key, value)
    end

    return true
end

function library:DeleteConfig(name)
    local configName = safeConfigName(name)
    local filePath = CONFIG_FOLDER .. "/" .. configName .. ".json"

    if type(isfile) == "function" and isfile(filePath) and type(delfile) == "function" then
        return pcall(delfile, filePath)
    end

    return false
end

function library:ResetConfig()
    if self.DefaultFlags then
        for key, value in pairs(self.DefaultFlags) do
            self.Flags[key] = value
            self:ApplyConfigBinding(key, value)
        end
    end
end

