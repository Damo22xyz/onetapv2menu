                TextXAlignment = Enum.TextXAlignment.Left
            }, row)

            local dropdown = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 26),
                Position = UDim2.fromOffset(0, 21),
                BackgroundColor3 = theme.panel2,
                BorderSizePixel = 0,
