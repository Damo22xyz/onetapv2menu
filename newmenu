            }, knob)

            local function updateToggle()
                TweenService:Create(toggle, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = enabled and theme.accent or theme.panel3
                }):Play()

                TweenService:Create(knob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = UDim2.fromOffset(9, 9),
                    BackgroundTransparency = 1
                }):Play()

                library.Flags[label] = enabled
                if callback then
                    callback(enabled, key)
                end
            end

            keyButton.MouseButton1Click:Connect(function()
                listening = true
                keyButton.Text = "..."
                keyButton.TextColor3 = theme.accentSoft
            end)

            toggle.MouseButton1Click:Connect(function()
                enabled = not enabled
                updateToggle()
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
                    return
                end

                if listening then
                    if input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.Backspace then
                        key = "NONE"
                    else
                        key = input.KeyCode.Name
                    end

                    keyButton.Text = key
                    keyButton.TextColor3 = theme.text
                    listening = false
                    library.Flags[label .. " Keybind"] = key
                    updateToggle()
                elseif key ~= "NONE" and input.KeyCode.Name == key then
                    enabled = not enabled
                    updateToggle()
                end
            end)

            library.Flags[label .. " Keybind"] = key
            registerElement(label, row)
            updateToggle()
            return row
        end

        function section:AddSlider(label, min, max, default, callback, decimals, suffix)
            local value = math.clamp(default or min, min, max)
            local places = decimals or 0
            local multiplier = 10 ^ places
            local valueSuffix = suffix or ""

            local row = new("Frame", {
                Size = UDim2.new(1, 0, 0, 52),
                BackgroundTransparency = 1
            }, elements)

            new("TextLabel", {
                Size = UDim2.new(1, -78, 0, 26),
                BackgroundTransparency = 1,
                Text = label,
                Font = Enum.Font.Gotham,
                TextSize = 14,
                TextColor3 = theme.text,
                TextXAlignment = Enum.TextXAlignment.Left
            }, row)

            local valueLabel = new("TextLabel", {
                Size = UDim2.fromOffset(66, 24),
                Position = UDim2.new(1, -66, 0, 0),
                BackgroundTransparency = 1,
                Text = tostring(value) .. valueSuffix,
                Font = Enum.Font.Gotham,
                TextSize = 14,
                TextColor3 = theme.subtext,
                TextXAlignment = Enum.TextXAlignment.Right
            }, row)

            local bar = new("Frame", {
                Size = UDim2.new(1, 0, 0, 8),
                Position = UDim2.fromOffset(0, 34),
                BackgroundColor3 = Color3.fromRGB(12, 15, 16),
                BorderSizePixel = 0
            }, row)

            local fill = new("Frame", {
                Name = "Fill",
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = theme.accent,
                BorderSizePixel = 0
            }, bar)

            local knob = new("Frame", {
                Size = UDim2.fromOffset(14, 14),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
                BackgroundColor3 = theme.accent,
                BorderSizePixel = 0
            }, bar)

            new("UICorner", {
                CornerRadius = UDim.new(1, 0)
            }, knob)

            local draggingSlider = false

            local function setValue(v)
                local rounded = math.floor(v * multiplier + 0.5) / multiplier
                value = math.clamp(rounded, min, max)

                local alpha = (value - min) / (max - min)

                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = tostring(value) .. valueSuffix

                library.Flags[label] = value
                if callback then
                    callback(value)
                end
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSlider = true
                    setValue(min + (((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) * (max - min)))
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
                    setValue(min + (((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) * (max - min)))
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSlider = false
                end
            end)

            function section:Set(valueToSet)
                setValue(valueToSet)
            end

            registerElement(label, row)
