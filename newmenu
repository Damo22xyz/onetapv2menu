                Thickness = 1
            }, dropdown)

            local dropdownText = new("TextLabel", {
                Size = UDim2.new(1, -24, 1, 0),
                Position = UDim2.fromOffset(8, 0),
                BackgroundTransparency = 1,
                Text = selected,
                Font = Enum.Font.Gotham,
