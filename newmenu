function library:Search(query)
    query = string.lower(tostring(query or ""))
    library.SearchQuery = query

    local firstMatch

    for _, tab in pairs(library.Tabs) do
        for _, section in ipairs(tab.Sections) do
            local sectionMatches = query == "" or string.find(string.lower(section.Title), query, 1, true) ~= nil
            local visibleRows = 0

            for _, entry in ipairs(section.Elements) do
                local matches = sectionMatches
                    or query == ""
                    or string.find(string.lower(entry.Label), query, 1, true) ~= nil

                entry.Row.Visible = matches
                if matches then
                    visibleRows = visibleRows + 1
                end
            end

            section.Frame.Visible = query == "" or visibleRows > 0
            if section.Frame.Visible and not firstMatch then
                firstMatch = tab
            end
        end
    end

    if query ~= "" and firstMatch and library.CurrentTab ~= firstMatch then
        library:SetTab(firstMatch)
    end
end

