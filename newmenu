function library:RegisterConfigBinding(key, setValue, kind, setOptions)
    if key and type(setValue) == "function" then
        self.ConfigBindings[key] = {
            key = key,
            kind = kind,
            setValue = setValue,
            setOptions = type(setOptions) == "function" and setOptions or nil
        }
    end
end

function library:SetDropdownOptions(key, newOptions, defaultValue)
    if not self.ConfigBindings or not self.ConfigBindings[key] then
        return false
    end

    local binding = self.ConfigBindings[key]
    if type(binding.setOptions) ~= "function" then
        return false
    end

    binding.setOptions(newOptions, defaultValue)
    self.ConfigState[key] = defaultValue or (newOptions and newOptions[1]) or nil
    self.Flags[key] = self.ConfigState[key]
    return true
end

function library:ApplyConfigBinding(key, value)
    if not self.ConfigBindings then
        self.ConfigBindings = {}
    end

    self.ConfigState[key] = value

    local binding = self.ConfigBindings[key]
    if binding and type(binding.setValue) == "function" then
        local ok = pcall(function()
            binding.setValue(value)
        end)
        if ok then
            return true
        end
    end

    self.Flags[key] = value
    return false
end

